{
  "name": "dsh-launcher",
  "version": "1.3.0",
  "private": true,
  "description": "Keeps the console-free DeepSeek Harness desktop launcher installed, its desktop shortcut correct, and controls when the host ends after the last browser page closes. Windows only.",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "author": "ww12366",
  "scripts": {
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ww12366/dsh-launcher.git"
  },
  "homepage": "https://github.com/ww12366/dsh-launcher#readme",
  "bugs": {
    "url": "https://github.com/ww12366/dsh-launcher/issues"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "launcher",
    "splash",
    "windows",
    "shortcut",
    "console"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ]
}
